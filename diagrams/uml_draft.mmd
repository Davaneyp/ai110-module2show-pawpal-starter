classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) None
        +get_pets() list~Pet~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~str~ special_needs
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +bool completed
        +mark_complete() None
        +priority_value() int
        +edit(duration_minutes, priority, category) None
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +list~tuple~ plan
        +list~Task~ skipped
        +collect_tasks() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +filter_tasks(tasks: list~Task~) list~Task~
        +generate_plan() list~tuple~
        +explain_plan() str
    }

    Owner "1" *-- "1..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : schedules
